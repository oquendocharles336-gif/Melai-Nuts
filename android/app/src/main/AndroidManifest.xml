<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Release builds talk to Supabase/Firebase; INTERNET was only declared in the debug/profile manifests. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Push notifications (order status, refunds, low stock, expiring batches), Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Location (asked only when used, with an explanation first — lib/core/services/permission_service.dart):
         FINE is needed for riders' live delivery position (street-level accuracy, DriverLocationTracker);
         customers use the same permission once, for "Use my location" when pinning an address.
         COARSE must be declared with FINE (Android 12+ lets the person choose approximate). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Riders only: keep sharing with the screen off through a foreground service (visible notification),
         started only while the app is open and a run is out — no ACCESS_BACKGROUND_LOCATION.
         FOREGROUND_SERVICE(_LOCATION) is required by Android 14 for that service; WAKE_LOCK is used by
         geolocator's ForegroundNotificationConfig(enableWakeLock: true) so positions keep arriving while
         the screen is off. All three stop with the run. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Camera (barcode scanner, proof-of-delivery photo) is declared by the mobile_scanner and
         image_picker plugins themselves. No storage, contacts, phone, SMS or microphone permission. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Melai Nuts"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher (Android 11+ package visibility): "Navigate" opens Google Maps / Waze /
             Apple Maps links, "Open in Maps" a map link, and "Call customer" the dialer. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
