APP_NAME="Melai Nuts Admin"
APP_ENV=local
APP_KEY=
# FAST LOCAL MODE: false hides the debug error page and its overhead. Set true while fixing an error.
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Parallel requests for `php artisan serve` (macOS / Linux only: the PHP built-in server ignores it on Windows).
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# FAST LOCAL MODE: warning (debug writes a lot on every request).
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# FAST LOCAL MODE: file (no SQLite write on every request). redis if you have it.
SESSION_DRIVER=file
# Signed out after this many minutes without activity (session timeout).
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
# Cookies are HttpOnly and SameSite=lax by default (config/session.php); keep them.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): true. Only a plain-HTTP local machine may use false.
SESSION_SECURE_COOKIE=false
# Security headers (CSP / HSTS); keep both on.
SECURITY_CSP=true
SECURITY_HSTS=true
# Rate limit for every change (POST/PUT/DELETE) per login per minute.
MELAI_WRITE_LIMIT_PER_MINUTE=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# FAST LOCAL MODE: file (or redis). Shared by all PHP processes, so cache invalidation works everywhere.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Melai Nuts admin -------------------------------------------------------
# The website's admin login ("Melai Admin"), created by `php artisan db:seed`. REQUIRED, no defaults.
# It acts as the OWNER's app account automatically: no linking step, no second sign-in.
#   ADMIN_STAFF_UID = the owner's Firebase UID (staff_members.firebase_uid of the row with role
#                     'owner'). The standard setup. Supabase must report that row as an ACTIVE OWNER
#                     whose email equals ADMIN_EMAIL, or the sign-in is refused with the reason.
#   Empty ADMIN_STAFF_UID: the active owner row whose email equals ADMIN_EMAIL is used.
# Sign in with ADMIN_EMAIL + ADMIN_PASSWORD (or the owner's app password, when Firebase is set up).
# Changing ADMIN_EMAIL later? The seeder renames the existing "Melai Admin" login in place (no
# second admin). Or run: php artisan melai:change-admin-email <old email> <new email>
ADMIN_NAME="Melai Admin"
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_STAFF_UID=

# --- Firebase Authentication (recommended) -----------------------------------
# Lets people sign in with their Melai Nuts app email + password, and is needed for Create Account
# and password resets. Without it, website passwords still work (linked on the server). Values: Firebase console > Project settings > General.
#   FIREBASE_WEB_API_KEY = "Web API key" (same value as FIREBASE_API_KEY_WEB in ../env/firebase.json)
#   FIREBASE_PROJECT_ID  = "Project ID" (the same project as ../.firebaserc and ../env/firebase.json)
# The key only identifies the project; it is not a password. Never put a service-account JSON here.
# Check the values with: php artisan melai:firebase-check
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# true = website sign-in only for accounts whose email Firebase reports as verified.
# Staff created in the app's User Management never get a verification email, so leave false
# unless every staff member has verified their email.
FIREBASE_REQUIRE_VERIFIED_EMAIL=false

# Business data always comes from the mobile app's Supabase database (there is no other source).

# The mobile app's Supabase Postgres. Supabase dashboard > Connect > "Session pooler".
# User is the melai_admin_portal role from supabase/migrations/20261009000000_admin_portal.sql
# (on the pooler the user name is melai_admin_portal.<project-ref>). NEVER use the postgres
# password or the service_role key here.
SUPABASE_DB_HOST=aws-0-your-region.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=melai_admin_portal.your-project-ref
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
# Keep the database connection open between page loads (much faster). false = reconnect every request.
SUPABASE_DB_PERSISTENT=true
# Or one URL instead of the five lines above:
# SUPABASE_DB_URL=postgresql://melai_admin_portal.your-project-ref:PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres
SUPABASE_ORDER_WINDOW_DAYS=90
# Sales targets, stock-health and sales-rating ratios are owner settings in the database
# (Settings > Business settings on this website), not .env values.
# Pages and badges: seconds a database answer counts as fresh, per app account (0 = caching off).
DASHBOARD_CACHE_SECONDS=45
# After that, the cached answer is still shown at once for this long while the browser fetches the
# new one in the background (stale-while-revalidate). Any change made on this website invalidates
# every cached answer immediately.
MELAI_CACHE_STALE_SECONDS=300
# Reports cover whole days, so they count as fresh for longer.
MELAI_REPORTS_CACHE_SECONDS=120
# TEMPORARY measuring: Server-Timing header (DevTools > Network > Timing) + storage/logs/timing.log.
MELAI_TIMING=false

# HitPay Refund API (DORMANT: online payment is OFF by the owner's decision). Only needed to
# refund PAST online payments; cash refunds are handled by hand. Same key as the Edge Functions.
HITPAY_API_KEY=
HITPAY_ENV=sandbox
